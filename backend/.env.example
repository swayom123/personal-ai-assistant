# App Configuration
APP_NAME=personal-ai-assistant
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# API
API_V1_PREFIX=/api/v1

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# LLM Providers Configuration
DEFAULT_LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

LLM_TIMEOUT_SECONDS=30.0
PROFILE_CONFIG_PATH=backend/config/profile.json

# Voice Assistant Configuration
VOICE_WAKE_WORD="Hey Max"
VOICE_ASSISTANT_NAME="Max"
VOICE_WAKE_WORD_DETECTOR=openwakeword
VOICE_STT_MODEL=base
VOICE_STT_LANGUAGE=en
VOICE_TTS_PROVIDER=piper
VOICE_TTS_VOICE=en_US-lessac-medium
VOICE_SPEECH_SPEED=1.0
VOICE_VOLUME=1.0
VOICE_VAD_FILTER=true
